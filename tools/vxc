# ---- driving the PC from the terminal -------------------------------------
#
# The terminal and the page are two different processes on two different hosts
# most of the time, so there is no local socket to talk over. Both of them
# already talk to the auth service, so the commands go through it: this queues
# one, the page picks it up on its next poll, and the answer comes back over the
# session token. Nothing here fabricates a result — if the page is not attached,
# that is what it says.

AGENT_WAIT="${VXC_AGENT_WAIT:-60}"

# The answer comes back as text/plain, already flattened by the service.
#
# It used to be JSON parsed here with tr and sed, which broke the moment the page
# returned a nested object: the fields came out misaligned or not at all, and
# `vxc pc status` printed a blank line while exiting 0. The shell has no JSON
# parser and should not pretend to, so the flattening happens once on the
# service, where there is a real one.

# agent_send <argv-json> -> sets $RESP to the page's answer
#
# The argument is a bare JSON array; it is wrapped in {"argv": …} here so the
# service sees one documented shape and there is no second way to spell it.
agent_send() {
  _argv="{\"argv\":$1}"

  # Read the token without a subshell. $(...) runs in a subshell, so an exit
  # inside one only ends that subshell — the caller would carry on with an empty
  # token and the service would answer 400 instead of the real refusal.
  _tok=$(session_get token 2>/dev/null || true)
  if [ -z "$_tok" ]; then
    say ""
    bad "not signed in."
    say ""
    say "  ${C_BLD}vxc auth login${C_OFF} first — a PC command runs as your account."
    say ""
    exit 1
  fi

  http_post_auth "$AUTH_BASE/agent/command" "$_argv" "$_tok"
  if [ "$HTTP_STATUS" != "200" ]; then
    err=$(json_get "$RESP" error)
    desc=$(json_get "$RESP" error_description)
    case "$err" in
      no_pc_attached)
        say ""
        bad "no PC is listening on this session."
        say ""
        say "  The page has to be open and signed in with the same account."
        say "  Open it here, then run the command again:"
        say ""
        say "    ${C_BLD}vxc pc${C_OFF}"
        say ""
        exit 1
        ;;
      not_signed_in)
        say ""
        bad "the service does not know this session any more."
        say "  Sign in again: ${C_BLD}vxc auth login${C_OFF}"
        say ""
        exit 1
        ;;
      *)
        bad "the service returned HTTP $HTTP_STATUS${err:+ ($err)}"
        [ -n "$desc" ] && say "  $desc"
        exit 1
        ;;
    esac
  fi

  id=$(json_get "$RESP" id)
  if [ -z "$id" ]; then
    bad "the service queued the command but returned no id"
    exit 1
  fi

  # Wait for the page's answer. The service holds this open, so a command on a
  # live page comes back as fast as the page's poll allows. format=text means the
  # body is already printable — see agent_print_data.
  http_get "$AUTH_BASE/agent/result?id=$(urlencode "$id")&wait=$((AGENT_WAIT * 1000))&format=text" "$_tok"
  case "$HTTP_STATUS" in
    200) : ;;
    404) bad "that command is not on this session any more"; exit 1 ;;
    000) bad "the service stopped answering while the PC worked"; exit 1 ;;
    *)   bad "the service returned HTTP $HTTP_STATUS waiting for the answer"; exit 1 ;;
  esac

  case "$RESP" in
    pending)
      say ""
      bad "the PC did not answer within ${AGENT_WAIT}s."
      say "  It may have been closed, or lost the network."
      say ""
      exit 1
      ;;
    refused*)
      say ""
      bad "the PC refused it:"
      # sed, not `tail -n +2`. On the phone this ships to, tail is the uutils
      # coreutils build and `tail -n +2` never returns — the refusal print
      # hung the whole command until it was killed.
      printf '%s\n' "$RESP" | sed -n '2,$p' | sed -E 's/^/  /'
      say ""
      exit 1
      ;;
  esac
}

# Builds a JSON array from the arguments, quoting each one. Only strings are ever
# sent, so this is a join with escaping — not a JSON writer.
agent_argv_json() {
  _out='['
  _first=1
  for _a in "$@"; do
    if [ "$_first" -eq 0 ]; then _out="$_out,"; fi
    _first=0
    _esc=$(printf '%s' "$_a" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g')
    _out="$_out\"$_esc\""
  done
  printf '%s]' "$_out"
}

cmd_agent() {
  _sub="${1:-}"
  shift 2>/dev/null || true
  case "$_sub" in
    status|windows|open|close|focus|run)
      case "$_sub" in
        open|close|focus|run)
          # Each one says what it actually wants, because "open needs something
          # to open" tells the person nothing they could not already guess.
          if [ $# -eq 0 ]; then
            case "$_sub" in
              open)   bad "open needs an app id.";    _usage="vxc pc open <app>     ${C_DIM}vxc apps${C_OFF} lists the ids" ;;
              close)  bad "close needs a window id."; _usage="vxc pc close <app>    ${C_DIM}vxc pc windows${C_OFF} lists what is open" ;;
              focus)  bad "focus needs a window id."; _usage="vxc pc focus <app>    ${C_DIM}vxc pc windows${C_OFF} lists what is open" ;;
              *)      bad "run needs a command.";    _usage="vxc pc run <command>  runs it in the PC's terminal window" ;;
            esac
            say "  ${C_BLD}${_usage}${C_OFF}"
            exit 2
          fi
          agent_send "$(agent_argv_json "$_sub" "$@")"
          ;;
        *)
          agent_send "$(agent_argv_json "$_sub")"
          ;;
      esac
      say ""
      printf '%s\n' "$RESP"
      say ""
      ;;
    ""|help|-h)
      say ""
      say "  ${C_BLD}vxc pc${C_OFF} <command>"
      say ""
      say "    ${C_BLD}status${C_OFF}            what the open PC reports about itself"
      say "    ${C_BLD}windows${C_OFF}           the windows it has open"
      say "    ${C_BLD}open <app>${C_OFF}        open an app  (${C_BLD}vxc apps${C_OFF} lists ids)"
      say "    ${C_BLD}close <app>${C_OFF}       close an open window"
      say "    ${C_BLD}focus <app>${C_OFF}       bring an open window to the front"
      say "    ${C_BLD}run <command>${C_OFF}     run a command in the PC's in-page shell"
      say ""
      say "  ${C_DIM}run talks to the page's own shell: live readings and vxc, no kernel.${C_OFF}"
      say "  ${C_DIM}Run 'vxc pc' alone for how to get a real shell instead.${C_OFF}"
      say ""
      say "  The PC has to be open and signed in with the same account."
      say ""
      ;;
    *)
      bad "unknown: vxc pc $_sub"
      say "  run ${C_BLD}vxc pc help${C_OFF} for the list"
      exit 2
      ;;
  esac
}

usage() {
  cat <<EOF

${C_BLD}vxc${C_OFF} $VXC_VERSION — VirgoX Cloud PC

${C_BLD}USAGE${C_OFF}
  vxc auth login              sign in with a one-time code
  vxc auth status             show the current session
  vxc auth logout             clear the session
  vxc auth token              print the session token
  vxc auth serve [port]       run the auth service here (default 8787)
  vxc pc                      open the PC (prints the URL, opens it if it can)
  vxc pc status               ask the open PC what it is
  vxc pc windows              list the windows it has open
  vxc pc open <app>           open an app in it
  vxc pc close <app>          close a window
  vxc pc focus <app>          bring a window to the front
  vxc pc run <command>        run a command in its terminal window
  vxc app <name>              open an app inside the PC
  vxc apps                    list the app ids the PC accepts
  vxc config set auth <url>   point at your auth service (checked live)
  vxc config unset auth       go back to the built-in default
  vxc config get auth         show what is configured
  vxc version

${C_BLD}ENV${C_OFF}
  VXC_AUTH            auth service base URL
  VXC_WORKSTATION     workstation URL
  VXC_SCOPE           OAuth scope (default: $SCOPE)
  VXC_AGENT_WAIT      seconds to wait for the PC to answer (default 60)

EOF
}

# ---- dispatch -------------------------------------------------------------

case "${1:-}" in
  auth)
    case "${2:-}" in
      login)            shift 2; cmd_login "$@" ;;
      status|whoami)    cmd_status ;;
      token)            cmd_token ;;
      logout|signout)   cmd_logout ;;
      serve)            shift 2; cmd_serve "$@" ;;
      *)
        say ""
        bad "unknown: vxc auth ${2:-}"
        usage
        exit 2
        ;;
    esac
    ;;
  pc)      shift 2>/dev/null || true
           if [ $# -gt 0 ]; then cmd_agent "$@"; else cmd_pc; fi ;;
  app)     shift; cmd_app "$@" ;;
  apps)    cmd_apps ;;
  config)  shift; cmd_config "$@" ;;
  version|--version|-v) say "vxc $VXC_VERSION" ;;
  help|--help|-h|"") usage ;;
  *)       say ""; bad "unknown command: $1"; usage; exit 2 ;;
esac