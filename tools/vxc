#!/bin/sh
# vxc — VirgoX Cloud PC command line
#
#   vxc auth login     device login: prints a one-time code and a link,
#                      waits for you to approve it on any device, then hands
#                      the session to the web workstation
#   vxc auth status    who is this machine signed in as
#   vxc auth logout    drop the stored session
#   vxc auth token     print the session token
#   vxc app <name>     open an app in the web workstation
#   vxc apps           list the apps you can open
#
# POSIX sh, no jq, no node. curl if present, otherwise wget.

set -u

VXC_VERSION="1.6.0"

# ---- config ---------------------------------------------------------------

CONFIG_DIR="${VXC_CONFIG_DIR:-$HOME/.config/vxc}"
CONFIG_FILE="$CONFIG_DIR/config"
SESSION_FILE="$CONFIG_DIR/session"

# Base URL of the VirgoX auth service. Defaults to loopback: `vxc auth login`
# starts the service itself when nothing is listening, so a fresh install needs
# no configuration at all. Override with VXC_AUTH or `vxc config set auth`.
AUTH_BASE="${VXC_AUTH:-http://127.0.0.1:8787}"
CLIENT_ID="${VXC_CLIENT_ID:-virgox-cloud-pc}"
SCOPE="${VXC_SCOPE:-workstation:read}"
WORKSTATION_URL="${VXC_WORKSTATION:-https://darkvirgoyt-beep.github.io/VirgoX-Cloud-Computer/}"

if [ -z "$AUTH_BASE" ] && [ -f "$CONFIG_FILE" ]; then
  # shellcheck disable=SC1090
  . "$CONFIG_FILE"
fi
AUTH_BASE="${VXC_AUTH:-$AUTH_BASE}"
AUTH_BASE="${AUTH_BASE:-http://127.0.0.1:8787}"

# ---- output ---------------------------------------------------------------

if [ -t 1 ] && [ -z "${NO_COLOR:-}" ]; then
  C_DIM=$(printf '\033[2m'); C_RED=$(printf '\033[31m'); C_GRN=$(printf '\033[32m')
  C_YLW=$(printf '\033[33m'); C_BLU=$(printf '\033[34m'); C_BLD=$(printf '\033[1m')
  C_OFF=$(printf '\033[0m')
else
  C_DIM=""; C_RED=""; C_GRN=""; C_YLW=""; C_BLU=""; C_BLD=""; C_OFF=""
fi

say()  { printf '%s\n' "$*"; }
dim()  { printf '%s%s%s\n' "$C_DIM" "$*" "$C_OFF"; }
ok()   { printf '%s✓%s %s\n' "$C_GRN" "$C_OFF" "$*"; }
bad()  { printf '%s✖%s %s\n' "$C_RED" "$C_OFF" "$*" >&2; }
warn() { printf '%s!%s %s\n' "$C_YLW" "$C_OFF" "$*" >&2; }

# ---- http -----------------------------------------------------------------

have_curl=0
command -v curl >/dev/null 2>&1 && have_curl=1

# Split "<body>\n<status>" using shell expansion only.
#
# This deliberately avoids `... | tail -n1`: piping into tail is unreliable on
# some Android/Termux builds, and two extra forks per request is wasted anyway.
NL='
'
HTTP_STATUS=""
RESP=""

# http_post <url> <json-body>  -> sets $RESP and $HTTP_STATUS (globals, not stdout:
# $(...) runs in a subshell so assignments made inside it are lost on return)
http_post() {
  _url="$1"; _json="$2"
  if [ "$have_curl" -eq 1 ]; then
    _out=$(curl -sS -X POST "$_url" \
      -H 'Content-Type: application/json' \
      -H 'Accept: application/json' \
      -d "$_json" -w '\n%{http_code}' 2>/dev/null)
  elif command -v wget >/dev/null 2>&1; then
    _out=$(wget -q -O- --header='Content-Type: application/json' \
      --post-data="$_json" "$_url" 2>/dev/null; printf '\n000')
  else
    HTTP_STATUS="000"; RESP=""
    bad "need curl or wget — run: pkg install curl"
    return 127
  fi
  HTTP_STATUS="${_out##*${NL}}"
  RESP="${_out%${NL}*}"
}

# http_get <url> [bearer-token] -> same, with an Authorization header when a token
# is given. The agent endpoints all require the session token, and a GET with a
# body is not a thing, so this cannot be folded into http_post.
http_get() {
  _url="$1"; _tok="${2:-}"
  # No arrays here: this runs under /bin/sh, which on Termux is dash-adjacent and
  # has no "${arr[@]}". The header is appended to the curl args as one word
  # because curl takes "Header: value" as a single argv entry either way.
  if [ -n "$_tok" ]; then
    _hdr="Authorization: Bearer $_tok"
  else
    _hdr=""
  fi
  if [ "$have_curl" -eq 1 ]; then
    if [ -n "$_hdr" ]; then
      _out=$(curl -sS -m 60 -H "$_hdr" -H 'Accept: application/json' \
        "$_url" -w '\n%{http_code}' 2>/dev/null)
    else
      _out=$(curl -sS -m 60 -H 'Accept: application/json' \
        "$_url" -w '\n%{http_code}' 2>/dev/null)
    fi
  elif command -v wget >/dev/null 2>&1; then
    if [ -n "$_hdr" ]; then
      _out=$(wget -q -O- --timeout=60 --header="$_hdr" "$_url" 2>/dev/null; printf '\n000')
    else
      _out=$(wget -q -O- --timeout=60 "$_url" 2>/dev/null; printf '\n000')
    fi
  else
    HTTP_STATUS="000"; RESP=""
    bad "need curl or wget — run: pkg install curl"
    return 127
  fi
  HTTP_STATUS="${_out##*${NL}}"
  RESP="${_out%${NL}*}"
}

# http_post_auth <url> <json-body> <bearer-token> -> same, authenticated
http_post_auth() {
  _url="$1"; _json="$2"; _tok="$3"
  if [ "$have_curl" -eq 1 ]; then
    _out=$(curl -sS -m 60 -X POST "$_url" \
      -H 'Content-Type: application/json' \
      -H 'Accept: application/json' \
      -H "Authorization: Bearer $_tok" \
      -d "$_json" -w '\n%{http_code}' 2>/dev/null)
  elif command -v wget >/dev/null 2>&1; then
    _out=$(wget -q -O- --timeout=60 --method=POST \
      --header='Content-Type: application/json' \
      --header="Authorization: Bearer $_tok" \
      --body-data="$_json" "$_url" 2>/dev/null; printf '\n000')
  else
    HTTP_STATUS="000"; RESP=""
    bad "need curl or wget — run: pkg install curl"
    return 127
  fi
  HTTP_STATUS="${_out##*${NL}}"
  RESP="${_out%${NL}*}"
}

# http_post_form <url> <form-encoded> -> same
http_post_form() {
  _url="$1"; _form="$2"
  if [ "$have_curl" -eq 1 ]; then
    _out=$(curl -sS -X POST "$_url" \
      -H 'Content-Type: application/x-www-form-urlencoded' \
      -H 'Accept: application/json' \
      --data "$_form" -w '\n%{http_code}' 2>/dev/null)
  elif command -v wget >/dev/null 2>&1; then
    _out=$(wget -q -O- --header='Content-Type: application/x-www-form-urlencoded' \
      --post-data="$_form" "$_url" 2>/dev/null; printf '\n000')
  else
    HTTP_STATUS="000"; RESP=""
    bad "need curl or wget — run: pkg install curl"
    return 127
  fi
  HTTP_STATUS="${_out##*${NL}}"
  RESP="${_out%${NL}*}"
}

# ---- json (no jq) ---------------------------------------------------------

# json_get <json> <key>  -> raw value with quotes stripped
json_get() {
  printf '%s' "$1" \
    | tr ',' '\n' \
    | grep -m1 "\"$2\"" \
    | sed -E "s/^.*\"$2\"[[:space:]]*:[[:space:]]*//" \
    | sed -E 's/[,}[:space:]]*$//' \
    | sed -E 's/^"//; s/"$//' \
    || true
}

# The claim is base64url from the service and the auth base is a URL, so both go
# into a query string. Percent-encoding by hand rather than reaching for a
# dependency, because the whole point of this script is that there isn't one.
#
# Everything is encoded to %XX, then the RFC 3986 unreserved set is decoded back
# out. `&` and `=` are deliberately NOT in that set: unencoded, they would end
# the parameter and start a new one, which is a session claim going somewhere it
# was never meant to go.
urlencode() {
  printf '%s' "$1" | od -An -tx1 -v | tr -d ' \n' | sed -E 's/(..)/%&/g' \
    | sed -E 's/%(4[1-9a-f]|5[0-9a]|6[1-9a-f]|7[0-9a]|3[0-9]|2d|2e|5f|7e)/\\x\1/g' \
    | xargs -0 printf '%b'
}

# ---- session file ---------------------------------------------------------

session_set() {
  mkdir -p "$CONFIG_DIR"
  chmod 700 "$CONFIG_DIR"
  umask 077
  printf '%s\n' "$1" > "$SESSION_FILE"
  chmod 600 "$SESSION_FILE"
  umask 022
}

session_get() {
  [ -f "$SESSION_FILE" ] || return 1
  grep -m1 "^$1=" "$SESSION_FILE" | cut -d= -f2-
}

# ---- commands -------------------------------------------------------------

require_auth_base() {
  if [ -z "$AUTH_BASE" ]; then
    bad "no auth service configured."
    say ""
    say "  Normally ${C_BLD}vxc auth login${C_OFF} starts a service on this machine by"
    say "  itself, so this only happens if VXC_AUTH was cleared. Put it back:"
    say ""
    say "    ${C_BLD}unset VXC_AUTH${C_OFF}"
    say "    ${C_BLD}vxc auth login${C_OFF}"
    say ""
    say "  To use one on another machine instead, give its real address:"
    say ""
    say "    ${C_BLD}vxc config set auth http://<that-machine>:8787${C_OFF}"
    say ""
    exit 2
  fi
}

# ---- local auth service --------------------------------------------------
#
# `vxc auth login` should be one command. If nothing is reachable we start the
# auth service ourselves, in the background, run the device flow against it, and
# shut it down afterwards. That keeps the user out of the "clone the repo, run
# node, configure a URL" dance.

NODE_BIN=""
find_node() {
  if command -v node >/dev/null 2>&1; then NODE_BIN=node
  elif command -v nodejs >/dev/null 2>&1; then NODE_BIN=nodejs
  fi
}

service_script() {
  printf '%s' "$CONFIG_DIR/auth-service.js"
}

# fetch the service script if we do not already have it
ensure_service() {
  _dest="$CONFIG_DIR/auth-service.js"
  if [ -s "$_dest" ]; then return 0; fi

  mkdir -p "$CONFIG_DIR"
  local src="$WORKSTATION_URL/server/auth-service.js"
  printf '  fetching auth service … '
  if [ "$have_curl" -eq 1 ]; then
    curl -fsSL "$src" -o "$_dest" >/dev/null 2>&1
  else
    wget -qO "$_dest" "$src" >/dev/null 2>&1
  fi
  if [ ! -s "$_dest" ]; then
    printf '%s\n' "failed"
    warn "could not download the auth service from $src"
    return 1
  fi
  printf '%s\n' "ok"
  return 0
}

# health <url> -> 0 if something answers /health
health() {
  if [ "$have_curl" -eq 1 ]; then
    curl -fsS -m 2 "$1/health" >/dev/null 2>&1
  else
    wget -q -T 2 -O /dev/null "$1/health" >/dev/null 2>&1
  fi
}

AUTH_PID=""

start_local_service() {
  _port="$1"
  _url="http://127.0.0.1:$_port"

  if health "$_url"; then
    return 0
  fi

  find_node
  if [ -z "$NODE_BIN" ]; then
    bad "no node found — run: pkg install nodejs"
    return 1
  fi

  ensure_service || return 1

  printf '  starting local auth service on port %s … ' "$_port"
  # The service does not serve the approval page — auth.html is a static file on
  # the workstation. Without this the verification URI would point at the
  # service root and the link the CLI prints would 404.
  PORT="$_port" HOST=127.0.0.1 \
  VXC_VERIFY_URL="${WORKSTATION_URL}auth.html" \
    "$NODE_BIN" "$(service_script)" \
    >"$CONFIG_DIR/auth-service.log" 2>&1 &
  AUTH_PID=$!

  # Wait for it to answer.
  _n=0
  while [ "$_n" -lt 25 ]; do
    if health "$_url"; then
      printf '%s\n' "ok"
      return 0
    fi
    # If it died, do not spin for 25s.
    kill -0 "$AUTH_PID" 2>/dev/null || break
    sleep 1
    _n=$((_n + 1))
  done

  printf '%s\n' "failed"
  stop_local_service
  warn "the auth service did not come up — see $CONFIG_DIR/auth-service.log"
  return 1
}

stop_local_service() {
  if [ -n "$AUTH_PID" ]; then
    kill "$AUTH_PID" 2>/dev/null
    wait "$AUTH_PID" 2>/dev/null
    AUTH_PID=""
  fi
}

cmd_serve() {
  port="${1:-8787}"
  find_node
  [ -n "$NODE_BIN" ] || { bad "no node found — run: pkg install nodejs"; exit 1; }
  ensure_service || exit 1

  trap 'stop_local_service; exit 0' INT TERM
  say ""
  dim "  serving on http://127.0.0.1:$port"
  dim "  log: $CONFIG_DIR/auth-service.log"
  say ""
  PORT="$port" HOST=127.0.0.1 \
  VXC_VERIFY_URL="${WORKSTATION_URL}auth.html" \
    "$NODE_BIN" "$(service_script)"
  stop_local_service
}

cmd_login() {
  require_auth_base

  if [ -n "$(session_get token 2>/dev/null)" ]; then
    warn "already signed in as $(session_get email 2>/dev/null)"
    say "  Run ${C_BLD}vxc auth logout${C_OFF} first, or just continue."
    say ""
  fi

  printf '%s\n' ""
  printf '%sVirgoX Cloud PC — device login%s\n' "$C_BLD$C_BLU" "$C_OFF"
  printf '%s\n' ""
  # If nothing is reachable, run our own rather than making the user stand up a
  # server by hand. AUTH_BASE already defaults to 127.0.0.1.
  if ! health "$AUTH_BASE"; then
    case "$AUTH_BASE" in
      http://127.0.0.1:*|http://localhost:*)
        if start_local_service "${AUTH_BASE##*:}"; then
          trap 'stop_local_service' EXIT INT TERM
        else
          exit 1
        fi
        ;;
    esac
  fi

  printf '  Contacting %s … ' "$AUTH_BASE"

  http_post "$AUTH_BASE/device/code" \
    "{\"client_id\":\"$CLIENT_ID\",\"scope\":\"$SCOPE\"}"
  resp="$RESP"

  if [ "$HTTP_STATUS" = "000" ] || [ -z "$resp" ]; then
    printf '%s\n' ""
    bad "could not reach the auth service at $AUTH_BASE"
    say ""
    case "$AUTH_BASE" in
      http://127.0.0.1:*|http://localhost:*)
        say "  Start it here, in another terminal, then run this again:"
        say ""
        say "    ${C_BLD}vxc auth serve${C_OFF}"
        ;;
      *)
        say "  That host is not on this machine, so nothing here can start it."
        say "  Either run the service on that machine, in its own terminal:"
        say ""
        say "    ${C_BLD}vxc auth serve${C_OFF}"
        say ""
        say "  or go back to the one this machine starts by itself:"
        ;;
    esac
    say ""
    say "    ${C_BLD}vxc config unset auth${C_OFF}"
    say ""
    stop_local_service
    exit 1
  fi

  if [ "$HTTP_STATUS" != "200" ]; then
    printf '%s\n' "failed"
    err=$(json_get "$resp" error)
    desc=$(json_get "$resp" error_description)
    bad "auth service returned HTTP $HTTP_STATUS${err:+ ($err)}"
    [ -n "$desc" ] && say "  $desc"
    exit 1
  fi

  device_code=$(json_get "$resp" device_code)
  user_code=$(json_get "$resp" user_code)
  verify_uri=$(json_get "$resp" verification_uri_complete)
  [ -z "$verify_uri" ] && verify_uri=$(json_get "$resp" verification_uri)
  expires_in=$(json_get "$resp" expires_in)
  interval=$(json_get "$resp" interval)
  [ -z "$expires_in" ] && expires_in=900
  [ -z "$interval" ] && interval=5

  if [ -z "$device_code" ] || [ -z "$user_code" ]; then
    printf '%s\n' "failed"
    bad "auth service did not return a device code"
    exit 1
  fi

  printf '%s\n' "ok"
  printf '%s\n' ""
  printf '  %sCopy this one-time code:%s  %s%s%s\n' "$C_DIM" "$C_OFF" "$C_BLD$C_GRN" "$user_code" "$C_OFF"
  printf '%s\n' ""
  printf '  %sOpen this link on any phone or computer, then sign in:%s\n' "$C_DIM" "$C_OFF"
  printf '\n    %s%s%s\n\n' "$C_BLU" "$verify_uri" "$C_OFF"
  printf '  %sWaiting for approval — expires in %s min. Ctrl-C to cancel.%s\n\n' \
    "$C_DIM" "$((expires_in / 60))" "$C_OFF"

  # Open the link automatically if the user has a desktop browser.
  if command -v termux-open-url >/dev/null 2>&1; then
    termux-open-url "$verify_uri" >/dev/null 2>&1 && dim "  (opened in your browser)"
    printf '\n'
  fi

  deadline=$(( $(date +%s) + expires_in ))
  waited=0

  while [ "$(date +%s)" -lt "$deadline" ]; do
    sleep "$interval"

    http_post_form "$AUTH_BASE/token" \
      "client_id=$CLIENT_ID&device_code=$device_code&grant_type=urn%3Aietf%3Aparams%3Aoauth%3Agrant-type%3Adevice_code"
    resp="$RESP"

    token=$(json_get "$resp" access_token)
    if [ -n "$token" ]; then
      email=$(json_get "$resp" user_email)
      [ -z "$email" ] && email=$(json_get "$resp" email)
      granted_scope=$(json_get "$resp" scope)

      session_set "token=$token
email=$email
scope=$granted_scope
auth=$AUTH_BASE
granted_at=$(date +%s)"

      printf '\n'
      ok "authenticated as ${C_BLD}$email${C_OFF}"
      dim "  scope      $granted_scope"
      dim "  endpoint   $AUTH_BASE"

      # Hand the session to the web workstation. The service parks the token and
      # returns a one-shot claim; the URL below is what redeems it, so opening
      # that URL is what signs the PC in. Without the claim the page would have
      # no way to learn about a session approved in another process.
      http_post "$AUTH_BASE/session/push" \
        "{\"token\":\"$token\",\"email\":\"$email\",\"scope\":\"$granted_scope\"}"
      if [ "$HTTP_STATUS" = "200" ]; then
        claim=$(json_get "$RESP" claim)
        if [ -z "$claim" ]; then
          warn "service accepted the session but returned no claim — open the PC by hand and sign in there"
        else
          claim_url="vxc_claim=$(urlencode "$claim")&vxc_auth=$(urlencode "$AUTH_BASE")"
          pc_url="${WORKSTATION_URL}pc.html?$claim_url"
          printf '\n'
          ok "PC session queued"
          say ""
          say "  ${C_DIM}Open this to sign the PC in. The claim is one-shot:${C_OFF}"
          say "  ${C_BLU}$pc_url${C_OFF}"
          say ""
          if command -v termux-open-url >/dev/null 2>&1; then
            termux-open-url "$pc_url" >/dev/null 2>&1 && dim "  (opened in your browser)"
          fi
        fi
      else
        warn "could not queue the web session (HTTP $HTTP_STATUS)"
        dim "  the token is stored locally — vxc auth status still works"
        say "  the PC page will still ask you to sign in there"
      fi
      return 0
    fi

    err=$(json_get "$resp" error)
    case "$err" in
      authorization_pending)
        waited=$((waited + interval))
        printf '\r  %s· waiting for approval… %ss%s' "$C_DIM" "$waited" "$C_OFF"
        ;;
      slow_down)
        interval=$((interval + 5))
        printf '\r  %s· service asked us to slow down, polling every %ss%s' "$C_DIM" "$interval" "$C_OFF"
        ;;
      access_denied)
        printf '\r%s%s%s\n' "$(printf '\r\033[2K')" "" ""
        bad "the request was denied"
        exit 1
        ;;
      expired_token)
        printf '\r%s%s%s\n' "$(printf '\r\033[2K')" "" ""
        bad "the code expired before it was approved"
        say "  Run ${C_BLD}vxc auth login${C_OFF} again for a fresh code."
        exit 1
        ;;
      *)
        printf '\r%s%s%s\n' "$(printf '\r\033[2K')" "" ""
        desc=$(json_get "$resp" error_description)
        bad "auth error: ${err:-unknown}${desc:+ — $desc}"
        exit 1
        ;;
    esac
  done

  printf '\r%s%s%s\n' "$(printf '\r\033[2K')" "" ""
  bad "timed out waiting for approval"
  exit 1
}

cmd_status() {
  token=$(session_get token 2>/dev/null)
  if [ -z "$token" ]; then
    say ""
    warn "not signed in"
    say "  Run ${C_BLD}vxc auth login${C_OFF} to sign in."
    say ""
    return 1
  fi
  say ""
  ok "signed in"
  dim "  account   $(session_get email)"
  dim "  scope     $(session_get scope)"
  dim "  endpoint  $(session_get auth)"
  dim "  token     $(printf '%s' "$token" | cut -c1-8)…$(printf '%s' "$token" | rev | cut -c1-4 | rev)"
  say ""
}

cmd_token() {
  token=$(session_get token 2>/dev/null)
  if [ -z "$token" ]; then
    bad "not signed in"
    exit 1
  fi
  printf '%s\n' "$token"
}

cmd_logout() {
  if [ -f "$SESSION_FILE" ]; then
    auth=$(session_get auth)
    token=$(session_get token)
    if [ -n "$auth" ] && [ -n "$token" ]; then
      http_post "$auth/session/revoke" "{\"token\":\"$token\"}" >/dev/null 2>&1 || true
    fi
    rm -f "$SESSION_FILE"
    ok "session cleared from this device"
  else
    dim "no stored session"
  fi
}

# A URL that was never resolved is the most likely thing to be typed here: these
# placeholders are printed in this script's own error messages, so a user who
# copies one gets a config file that points nowhere and every later login fails
# with no explanation. Rejecting them at write time is cheaper than debugging it
# three commands later.
looks_like_placeholder() {
  case "$1" in
    *your-host*|*your-auth-host*|*your-auth*|*example.com*|*example.org*) return 0 ;;
    *'<'*|*'>'*|*" "*) return 0 ;;
  esac
  return 1
}

valid_http_url() {
  case "$1" in
    http://*|https://*) return 0 ;;
  esac
  return 1
}

# Reached now, not at the next login. A service that answers /health is real;
# one that does not is a typo or a machine that is not up, and either way the
# user should find out while they are still looking at this command.
require_reachable() {
  _url="${1%/}"
  if health "$_url"; then
    return 0
  fi
  bad "nothing answers at $_url/health — not saving it."
  say ""
  say "  Check the service is running:"
  say "    ${C_BLD}vxc auth serve${C_OFF}   ${C_DIM:-}on that machine, then re-run${C_OFF:-}"
  say ""
  say "  Or go back to the built-in default:"
  say "    ${C_BLD}vxc config unset auth${C_OFF}"
  say ""
  exit 1
}

cmd_config() {
  case "${1:-}" in
    set)
      key="${2:-}"; val="${3:-}"
      [ -z "$key" ] && { bad "usage: vxc config set <auth|workstation> <url>"; exit 2; }
      [ -z "$val" ] && { bad "usage: vxc config set $key <url>"; exit 2; }

      if looks_like_placeholder "$val"; then
        bad "'$val' is not a real address."
        say ""
        say "  That is the placeholder from this tool's own help text. Use the"
        say "  address of a machine you control, or keep the default:"
        say ""
        say "    ${C_BLD}vxc auth login${C_OFF}   ${C_DIM:-}starts a service here by itself${C_OFF:-}"
        say ""
        exit 1
      fi

      valid_http_url "$val" || { bad "must start with http:// or https:// — got '$val'"; exit 1; }

      # auth is checked against the live service. workstation is only used to
      # build links, and probing a Pages site to save it would make a typo there
      # fail the same way, so it is checked for shape alone.
      if [ "$key" = "auth" ]; then
        require_reachable "$val"
      fi

      mkdir -p "$CONFIG_DIR"
      touch "$CONFIG_FILE"
      grep -v "^$key=" "$CONFIG_FILE" > "$CONFIG_FILE.tmp" 2>/dev/null || true
      printf '%s=%s\n' "$key" "$val" >> "$CONFIG_FILE.tmp"
      mv "$CONFIG_FILE.tmp" "$CONFIG_FILE"
      ok "$key = $val"
      ;;
    unset)
      key="${2:-}"
      [ -z "$key" ] && { bad "usage: vxc config unset <auth|workstation>"; exit 2; }
      if [ -f "$CONFIG_FILE" ]; then
        grep -v "^$key=" "$CONFIG_FILE" > "$CONFIG_FILE.tmp" 2>/dev/null || true
        mv "$CONFIG_FILE.tmp" "$CONFIG_FILE"
      fi
      if [ "$key" = "auth" ]; then
        ok "auth reset to the built-in default (127.0.0.1:8787)"
      else
        ok "$key reset to its default"
      fi
      ;;
    get)
      key="${2:-}"
      [ -f "$CONFIG_FILE" ] && grep -m1 "^$key=" "$CONFIG_FILE" | cut -d= -f2- || true
      ;;
    get)
      key="${2:-}"
      [ -f "$CONFIG_FILE" ] && grep -m1 "^$key=" "$CONFIG_FILE" | cut -d= -f2- || true
      ;;
    *)
      say "usage: vxc config set <key> <url> | vxc config get <key> | vxc config unset <key>"
      ;;
  esac
}

