#!/bin/bash
# ==============================================================================
# ⚡ VirgoX Windows Command Prompt (CMD) Launcher
# Developer: Prince · VirgoYT (@darkvirgoyt-beep)
# ==============================================================================

. "$(dirname "$0")/vxc-paths.sh"
export DISPLAY="${DISPLAY:-:1}"
export WINEPREFIX="$VXC_WINE_PREFIX"

if which wine >/dev/null 2>&1 && [ -f "$VXC_WINE_PREFIX/system.reg" ]; then
    CMD_BIN="wine cmd.exe"
else
    CMD_BIN="/usr/local/bin/virgox-cmd"
fi

if [ -n "$1" ]; then
    $CMD_BIN "$@"
else
    xfce4-terminal --title="Command Prompt" \
      --color-bg="#0c0c0c" \
      --color-text="#cccccc" \
      --geometry=105x28 \
      -e "$CMD_BIN"
fi
