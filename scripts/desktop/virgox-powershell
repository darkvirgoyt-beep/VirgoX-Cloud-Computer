def get_win_path(path):
    rel = os.path.relpath(path, "/config")
    if rel == ".":
        return "C:\\Users\\VirgoX"
    win_rel = rel.replace("/", "\\")
    return f"C:\\Users\\VirgoX\\{win_rel}"

