#!/usr/bin/env python3
"""VirgoX Cloud CLI — login/status/logout like a small gh-style client."""
import argparse, getpass, json, os, pathlib, sys, time, urllib.request, urllib.error, urllib.parse, webbrowser

CONFIG = pathlib.Path(os.environ.get("XDG_CONFIG_HOME", pathlib.Path.home()/".config")) / "vxc" / "config.json"
DEFAULT_SERVER = os.environ.get("VIRGOX_SERVER", "http://127.0.0.1:8888").rstrip("/")

def load():
    try: return json.loads(CONFIG.read_text())
    except Exception: return {}

def save(data):
    CONFIG.parent.mkdir(parents=True, exist_ok=True)
    CONFIG.write_text(json.dumps(data, indent=2))
    os.chmod(CONFIG, 0o600)

def api(server, path, payload=None, query=None):
    url = server + path
    if query:
        url += "?" + urllib.parse.urlencode(query)
    data = json.dumps(payload).encode() if payload is not None else None
    req = urllib.request.Request(url, data=data, headers={"Content-Type":"application/json"} if data else {})
    with urllib.request.urlopen(req, timeout=15) as r:
        return json.loads(r.read().decode())

def login(args):
    cfg=load()
    server=(args.server or cfg.get("server") or DEFAULT_SERVER).rstrip("/")
    print(f"VirgoX host: {server}")
    try:
        start=api(server, "/api/auth/device/start", {})
        code=start["device_code"]
        url=start["verification_url"]
        print()
        print("🔐 Browser authorization required")
        print(f"Code: {code}")
        print(f"Open: {url}")
        try:
            webbrowser.open(url)
            print("✓ Opened the authorization page in your browser.")
        except Exception:
            print("Open the URL above manually.")
        print()
        print("Waiting for authorization", end="", flush=True)
        deadline=time.time()+int(start.get("expires_in",600))
        while time.time() < deadline:
            try:
                result=api(server, "/api/auth/device/poll", query={"code":code})
                if result.get("authenticated") and result.get("token"):
                    email=result.get("email") or ""
                    save({"server":server,"email":email,"token":result["token"]})
                    print()
                    print(f"✓ {email} logged in.")
                    print(f"✓ Session saved to {CONFIG}")
                    return 0
            except urllib.error.HTTPError as e:
                if e.code not in (404,):
                    print(f"\n✗ Authorization error: HTTP {e.code}", file=sys.stderr)
                    return 1
            except Exception as e:
                print(f"\n✗ Could not reach VirgoX: {e}", file=sys.stderr)
                return 1
            print(".", end="", flush=True)
            time.sleep(2)
        print("\n✗ Authorization timed out.", file=sys.stderr)
        return 1
    except Exception as e:
        print(f"✗ Could not start browser authorization: {e}", file=sys.stderr)
        return 1

